<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.truelight.ime.settings.SettingsActivity"
    android:isDefault="true"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:label="@string/subtype_en_us"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=english_us,AsciiCapable" />

    <subtype
        android:label="@string/subtype_vi_telex"
        android:imeSubtypeLocale="vi_VN"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=vietnamese_telex,AsciiCapable" />

</input-method>
